APP_NAME="Strikeball Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Kyiv
APP_URL=http://yourdomain.com

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# === БАЗА ДАННЫХ - ЗАПОЛНИ ЭТИ ПОЛЯ ===
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Для обычного хостинга используем file вместо Redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=strikeball_cache

# Mail (настрой если нужна отправка писем)
MAIL_MAILER=log

# Nova Poshta API (получи на https://devcenter.novaposhta.ua/)
NOVAPOSHTA_API_KEY=
NOVAPOSHTA_MODE=sandbox
NOVAPOSHTA_CACHE_TTL=86400

# Monobank Acquiring (получи на https://api.monobank.ua/)
MONO_TOKEN=
MONO_WEBHOOK_SECRET=
MONO_MODE=sandbox
MONO_REDIRECT_URL="${APP_URL}/payment/monobank/callback"
MONO_WEBHOOK_URL="${APP_URL}/payment/monobank/webhook"

# Admin credentials (ИЗМЕНИ ПОСЛЕ УСТАНОВКИ!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Shop settings
SHOP_CURRENCY=UAH
SHOP_DEFAULT_PROMO_CODE=START10
SHOP_TAX_RATE=0
