APP_NAME="Strikeball Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Kyiv
APP_URL=http://localhost

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=strikeball
DB_USERNAME=strikeball
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nova Poshta API
NOVAPOSHTA_API_KEY=
NOVAPOSHTA_MODE=sandbox
# When MODE=sandbox, mock data will be used instead of real API calls
NOVAPOSHTA_CACHE_TTL=86400

# Monobank Acquiring
MONO_TOKEN=
MONO_WEBHOOK_SECRET=
MONO_MODE=sandbox
# When MODE=sandbox, demo payment flow will be used
MONO_REDIRECT_URL="${APP_URL}/payment/monobank/callback"
MONO_WEBHOOK_URL="${APP_URL}/payment/monobank/webhook"

# Admin credentials (created by seeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# Shop settings
SHOP_CURRENCY=UAH
SHOP_DEFAULT_PROMO_CODE=START10
SHOP_TAX_RATE=0
